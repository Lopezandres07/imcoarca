{
  "name": "imcoarca",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:e2e": "npx playwright test tests/06-e2e-lifecycle.spec.ts",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "clean": "node -e \"['allure-results', 'allure-report', 'test-results'].forEach(d => require('fs').rmSync(d, { recursive: true, force: true }))\"",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "test:report": "npm run clean && npm test && npm run report"
  },
